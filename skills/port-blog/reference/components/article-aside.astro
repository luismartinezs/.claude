---
import type { Author } from '../content'
import type { Article } from '../blog.logic'
import AuthorCard from './author-card.astro'

export interface Props {
  author: Author
  relatedArticles: Article[]
  authors: Record<string, Author>
  class?: string
}

const { author, relatedArticles, authors, class: className = '' } = Astro.props
---

<aside class:list={['sticky top-20 space-y-6', className]}>
  <!-- Author card -->
  <AuthorCard author={author} />

  <!-- Related articles -->
  {relatedArticles.length > 0 && (
    <div class="space-y-4">
      <div class="border-t border-neutral-200 pt-6">
        <h2 class="text-lg font-semibold text-neutral-900">Related Articles</h2>
      </div>

      <ul class="space-y-4">
        {relatedArticles.map((article) => {
          const articleAuthor = authors[article.data.author];
          return (
            <li>
              <a href={`/blog/${article.id}/`} class="group flex gap-3">
                <img
                  src={article.data.image}
                  alt={article.data.title}
                  width="80"
                  height="80"
                  class="h-16 w-16 shrink-0 rounded-lg object-cover"
                  loading="lazy"
                />
                <div class="min-w-0">
                  <p class="text-sm font-semibold text-neutral-900 group-hover:text-primary-600 transition-colors line-clamp-2">
                    {article.data.title}
                  </p>
                  {articleAuthor && (
                    <p class="mt-1 text-xs text-neutral-500">{articleAuthor.name}</p>
                  )}
                </div>
              </a>
            </li>
          );
        })}
      </ul>
    </div>
  )}
</aside>
