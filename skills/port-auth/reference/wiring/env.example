# API
API_PORT=8787
# The one public origin (site + SPA + API). Links and the Google redirect URI are built from it.
APP_ORIGIN=http://localhost:4321

# Google sign-in (OAuth web client). Redirect URI to register: <APP_ORIGIN>/api/auth/google/callback
# Leave either empty to hide Google sign-in outside production.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Resend. Leave empty outside production: emails are written to .dev/outbox/ instead.
RESEND_API_KEY=
EMAIL_FROM=Pawacook <signin@pawacook.app>

